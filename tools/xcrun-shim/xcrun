#!/bin/sh
# Zig 0.15's bundled libc++ fails against the macOS 27 SDK headers (INFINITY
# undeclared). Point SDK lookups at an older SDK when one is available.
case "$*" in
  *--show-sdk-path*)
    for sdk in /Library/Developer/CommandLineTools/SDKs/MacOSX26*.sdk /Library/Developer/CommandLineTools/SDKs/MacOSX15*.sdk; do
      [ -d "$sdk" ] && { echo "$sdk"; exit 0; }
    done ;;
esac
exec /usr/bin/xcrun "$@"
